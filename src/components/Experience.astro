---
import { t, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t[lang];
---
<section id="experiencia" class="experience wrap" aria-labelledby="e-title">
  <h2 id="e-title" class="section-title">{d.experience.title}</h2>

  <ol class="log" role="list">
    {d.experience.roles.map((r) => (
      <li>
        <span class="period num">{r.period}</span>
        <div>
          <h3>{r.title} <span class="org">{r.org}</span></h3>
          <p>{r.text}</p>
        </div>
      </li>
    ))}
  </ol>

  <div class="split">
    <div>
      <h3 class="sub">{d.experience.studiesTitle}</h3>
      <ol class="log compact" role="list">
        {d.experience.studies.map((r) => (
          <li>
            <span class="period num">{r.period}</span>
            <p class="study">{r.title}{r.org && <span class="org">{r.org}</span>}</p>
          </li>
        ))}
      </ol>
    </div>

    <div>
      <h3 class="sub">{d.stack.title}</h3>
      <dl class="stack">
        {d.stack.groups.map((g) => (
          <div>
            <dt>{g.label}</dt>
            <dd>{g.items}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .experience { padding-block: clamp(4.5rem, 10vw, 8rem) 0; }

  .log { list-style: none; padding: 0; margin: 2rem 0 0; border-top: 1px solid var(--line); }
  .log > li {
    display: grid; grid-template-columns: minmax(0, 10rem) minmax(0, 1fr);
    gap: .35rem 2.5rem; padding-block: 1.5rem; border-bottom: 1px solid var(--line);
  }
  .period { font-family: var(--mono); font-size: var(--step--1); color: var(--info); padding-top: .15rem; white-space: nowrap; }
  .log h3 { font-size: 1.125rem; display: flex; flex-wrap: wrap; column-gap: .75rem; align-items: baseline; }
  .log p { margin-top: .5rem; max-width: var(--measure); }
  .org { font-family: var(--mono); font-weight: 400; font-size: var(--step--1); color: var(--muted); letter-spacing: 0; }

  .split {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem clamp(2rem, 5vw, 4rem); margin-top: clamp(3.5rem, 7vw, 5rem);
  }
  .sub { font-size: var(--step-1); }

  .compact { margin-top: 1.25rem; }
  .compact > li { grid-template-columns: minmax(0, 8rem) minmax(0, 1fr); gap: .25rem 1.5rem; padding-block: .85rem; }
  .log .study { margin: 0; font-weight: 600; display: flex; flex-direction: column; gap: .1rem; }

  .stack { margin: 1.25rem 0 0; border-top: 1px solid var(--line); }
  .stack > div {
    display: grid; grid-template-columns: minmax(0, 8rem) minmax(0, 1fr); gap: .25rem 1.5rem;
    padding-block: .85rem; border-bottom: 1px solid var(--line);
  }
  .stack dt { font-family: var(--mono); font-size: var(--step--1); font-weight: 600; padding-top: .15rem; }
  .stack dd { margin: 0; }

  @media (max-width: 900px) {
    .split { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 600px) {
    .log > li, .compact > li, .stack > div { grid-template-columns: minmax(0, 1fr); }
  }
</style>
