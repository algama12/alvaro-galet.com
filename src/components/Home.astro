---
import Base from '../layouts/Base.astro';
import StatusPanel from './StatusPanel.astro';
import Projects from './Projects.astro';
import Experience from './Experience.astro';
import { t, links, altPath, cvPath, homePath, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t[lang];
const other: Lang = lang === 'es' ? 'en' : 'es';
const buildDate = new Date().toISOString().slice(0, 10);
---
<Base lang={lang}>
  <a class="skip" href="#main">{d.a11y.skip}</a>

  <header class="top wrap">
    <a class="brand" href={homePath(lang)}>Álvaro Galet</a>
    <nav aria-label={d.a11y.mainNav}>
      <a href="#proyectos">{d.nav.projects}</a>
      <a href="#experiencia">{d.nav.experience}</a>
      <a href="#contacto">{d.nav.contact}</a>
      <a class="lang" href={altPath(lang)} hreflang={other} lang={other} aria-label={d.nav.switchLabel} title={d.nav.switchLabel} data-lang-switch={other}>
        <span aria-hidden="true" class:list={[{ on: lang === 'es' }]}>ES</span>
        <span aria-hidden="true" class:list={[{ on: lang === 'en' }]}>EN</span>
      </a>
    </nav>
  </header>

  <main id="main">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="intro">
        <h1 id="hero-title">Álvaro Galet</h1>
        <p class="role">{d.hero.role}</p>
        <p class="pitch">{d.hero.intro}</p>
        <p class="where">{d.hero.location}</p>
        <div class="actions">
          <a class="btn primary" href={`mailto:${links.email}`}>{d.hero.ctaMail}</a>
          <a class="btn" href={cvPath(lang)} download>{d.hero.cv}</a>
          <a class="btn quiet" href={links.github} rel="me">GitHub</a>
          <a class="btn quiet" href={links.linkedin} rel="me">LinkedIn</a>
        </div>
      </div>
      <div class="live">
        <StatusPanel lang={lang} />
        <p class="live-foot">{d.trace.footnote}</p>
      </div>
    </section>

    <Projects lang={lang} />
    <Experience lang={lang} />

    <section id="contacto" class="contact wrap" aria-labelledby="c-title">
      <h2 id="c-title" class="section-title">{d.contact.title}</h2>
      <p>{d.contact.text}</p>
      <a class="mail" href={`mailto:${links.email}`}>{links.email}</a>
    </section>
  </main>

  <footer class="foot wrap">
    <p>© {new Date().getFullYear()} Álvaro Galet Martín. {d.footer}</p>
    <p class="build num">{d.build.replace('{date}', buildDate)}</p>
  </footer>
</Base>

<script>
  // Remember the chosen language (convenience only; the site works without it).
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) => {
    a.addEventListener('click', () => {
      try { localStorage.setItem('lang', a.dataset.langSwitch!); } catch {}
    });
  });
</script>

<style>
  .top {
    display: flex; align-items: center; justify-content: space-between; gap: .75rem 1.5rem;
    padding-block: 1.25rem; flex-wrap: wrap;
  }
  .brand { font-family: var(--mono); font-weight: 700; text-decoration: none; letter-spacing: -0.01em; }
  nav { display: flex; align-items: center; gap: .25rem 1.25rem; font-family: var(--mono); font-size: var(--step--1); flex-wrap: wrap; }
  nav a { text-decoration: none; color: var(--muted); padding-block: .5rem; transition: color 150ms ease; }
  @media (hover: hover) and (pointer: fine) {
    nav a:hover { color: var(--ink); }
  }
  .lang {
    display: inline-flex; border: 1px solid var(--line-strong); border-radius: var(--radius); overflow: hidden;
    font-weight: 600; font-size: var(--step--2); padding: 0 !important;
  }
  .lang span { padding: .3rem .55rem; color: var(--muted); }
  .lang span.on { background: var(--ink); color: var(--bg); }

  /* Hero: who, plus the live machine that serves the page */
  .hero {
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 3rem clamp(2rem, 5vw, 4.5rem); align-items: start;
    padding-block: clamp(2.5rem, 8vw, 6rem) 0;
  }
  .hero h1 { font-size: var(--step-3); font-weight: 700; letter-spacing: -0.04em; line-height: 0.95; }
  .role { font-family: var(--mono); font-size: var(--step-1); color: var(--muted); margin-top: 1rem; }
  .pitch { max-width: 56ch; margin-top: 1.75rem; font-size: 1.1875rem; line-height: 1.55; }
  .where { font-family: var(--mono); color: var(--muted); margin-top: 1.25rem; font-size: var(--step--1); }
  .actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 2rem; }
  /* A soft pool of cool light behind the live panel; sits under all content */
  .live { min-width: 0; position: relative; isolation: isolate; }
  .live::before {
    content: ''; position: absolute; inset: -35% -40% -25%; z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, var(--glow), transparent);
  }
  .live-foot { margin-top: .9rem; color: var(--muted); font-size: var(--step--1); line-height: 1.5; max-width: 60ch; }

  .contact { padding-block: clamp(4.5rem, 10vw, 8rem) clamp(3rem, 6vw, 4.5rem); }
  .contact p { margin-top: 1.25rem; max-width: 52ch; color: var(--muted); }
  .mail {
    display: inline-block; margin-top: 1.25rem; font-family: var(--mono);
    font-size: clamp(1.125rem, 4.4vw, 2.5rem); font-weight: 650; letter-spacing: -0.03em;
    overflow-wrap: anywhere; text-decoration-thickness: 2px; text-underline-offset: 6px;
  }

  .foot {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem 2rem;
    padding-block: 1.5rem 3rem; border-top: 1px solid var(--line);
    color: var(--muted); font-size: var(--step--1);
  }
  .build { font-family: var(--mono); font-size: var(--step--2); }

  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
  }
</style>
