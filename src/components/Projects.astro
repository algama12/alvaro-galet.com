---
import ProjectMedia from './ProjectMedia.astro';
import { t, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = t[lang].projects;
const featured = p.items.filter((i) => i.featured);
const rest = p.items.filter((i) => !i.featured);
const host = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---
<section id="proyectos" class="projects wrap" aria-labelledby="p-title">
  <div class="head">
    <h2 id="p-title" class="section-title">{p.title}</h2>
    <p class="lead">{p.lead}</p>
  </div>

  <ul class="featured" role="list">
    {featured.map((item) => (
      <li class="feature">
        <div class="f-media">
          <ProjectMedia slug={item.slug} name={item.name} url={item.url} media={item.media} diagram={item.diagram} pendingLabel={p.mediaPending} />
        </div>
        <div class="f-body">
          <div class="f-title">
            <h3>{item.name}</h3>
            <span class="year num">{item.year}</span>
          </div>
          <p class="summary">{item.summary}</p>
          <p class="detail">{item.detail}</p>
          {(item.metric || item.outcome) && (
            <ul class="results" role="list">
              {item.metric && <li class="metric">{item.metric}</li>}
              {item.outcome && <li>{item.outcome}</li>}
            </ul>
          )}
          <p class="tech">{item.stack.join(' · ')}</p>
          {(item.url || item.repo) && (
            <p class="links">
              {item.url && <a href={item.url}>{p.visit} <span class="host">{host(item.url)}</span></a>}
              {item.repo && <a href={item.repo}>{p.code}</a>}
            </p>
          )}
        </div>
      </li>
    ))}
  </ul>

  {rest.length > 0 && (
    <div class="more">
      <h3 class="more-title">{p.moreTitle}</h3>
      <ul class="compact" role="list">
        {rest.map((item) => (
          <li>
            <div class="c-name">
              <h4>{item.name}</h4>
              <span class="year num">{item.year}</span>
            </div>
            <div class="c-body">
              <p class="summary">{item.summary}</p>
              <p class="detail">{item.detail}</p>
              {(item.metric || item.outcome) && (
                <p class="c-result">{[item.metric, item.outcome].filter(Boolean).join(' · ')}</p>
              )}
              {(item.url || item.repo) && (
                <p class="links">
                  {item.url && <a href={item.url}>{p.visit} <span class="host">{host(item.url)}</span></a>}
                  {item.repo && <a href={item.repo}>{p.code}</a>}
                </p>
              )}
            </div>
            <p class="tech c-tech">{item.stack.join(' · ')}</p>
          </li>
        ))}
      </ul>
    </div>
  )}
</section>

<style>
  .projects { padding-block: clamp(4rem, 9vw, 7rem) 0; }
  .head { display: grid; gap: .75rem; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .lead { color: var(--muted); max-width: 52ch; }

  .featured { list-style: none; padding: 0; margin: 0; display: grid; gap: clamp(3.5rem, 8vw, 6rem); }
  .feature {
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 2rem clamp(2rem, 4vw, 3.5rem); align-items: start;
  }
  .feature:nth-child(even) .f-media { order: 2; }

  .f-title { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .f-title h3 { font-size: var(--step-2); }
  .year { font-family: var(--mono); font-size: var(--step--1); color: var(--info); }
  .summary { font-size: var(--step-1); line-height: 1.4; margin-top: .75rem; font-weight: 500; }
  .detail { margin-top: .75rem; max-width: var(--measure); }

  .results { list-style: none; padding: 0; margin: 1.25rem 0 0; display: grid; gap: .35rem; font-family: var(--mono); font-size: var(--step--1); }
  .results li { display: flex; align-items: baseline; gap: .6rem; }
  .results li::before {
    content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--ok);
    flex: none; transform: translateY(-1px);
  }
  .results .metric { font-weight: 600; color: var(--accent); }

  .tech {
    margin-top: 1.25rem; padding-top: .75rem; border-top: 1px solid var(--line);
    font-family: var(--mono); font-size: var(--step--2); color: var(--muted);
  }
  .links {
    display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: 1rem;
    font-family: var(--mono); font-size: var(--step--1); font-weight: 600;
  }
  .links a { display: inline-flex; gap: .5rem; padding-block: .35rem; }
  .host { font-weight: 400; color: var(--muted); }

  /* Compact list for secondary work */
  .more { margin-top: clamp(4rem, 9vw, 6.5rem); }
  .more-title { font-size: var(--step-1); }
  .compact { list-style: none; padding: 0; margin: 1.25rem 0 0; border-top: 1px solid var(--line); }
  .compact > li {
    display: grid; grid-template-columns: minmax(0, 15rem) minmax(0, 1fr) minmax(0, 14rem);
    gap: .5rem 2.5rem; padding-block: 1.5rem; border-bottom: 1px solid var(--line);
  }
  .c-name { display: flex; flex-direction: column; gap: .25rem; }
  .c-name h4 { margin: 0; font-family: var(--mono); font-size: 1.0625rem; font-weight: 650; letter-spacing: -0.01em; line-height: 1.3; }
  .c-body .summary { margin-top: 0; font-size: var(--step-0); font-weight: 600; }
  .c-body .detail { margin-top: .35rem; color: var(--muted); }
  .c-result { margin-top: .6rem; font-family: var(--mono); font-size: var(--step--1); }
  .c-tech { margin: 0; padding: 0; border: 0; line-height: 1.7; }

  @media (max-width: 900px) {
    .feature { grid-template-columns: minmax(0, 1fr); }
    .feature:nth-child(even) .f-media { order: 0; }
    .compact > li { grid-template-columns: minmax(0, 12rem) minmax(0, 1fr); }
    .c-tech { grid-column: 2; }
  }
  @media (max-width: 600px) {
    .compact > li { grid-template-columns: minmax(0, 1fr); }
    .c-name { flex-direction: row; justify-content: space-between; align-items: baseline; }
    .c-tech { grid-column: auto; }
  }
</style>
