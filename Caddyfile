# Cloudflare termina TLS; el túnel habla con este contenedor por HTTP interno.
{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Estado del homelab: solo este fichero exacto, desde el volumen del cron.
	# Nada más de /srv-status es alcanzable.
	handle /status.json {
		root * /srv-status
		header Cache-Control "no-store"
		file_server
	}

	# Todo lo demás: la web estática
	handle {
		root * /srv

		# Assets con hash en el nombre: caché larga
		@hashed path /_astro/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# HTML: siempre revalidar, para que un despliegue se vea al momento
		@html path / /en/ *.html
		header @html Cache-Control "public, max-age=0, must-revalidate"

		file_server
	}

	# El root se fija aquí también: un 404 de /status.json no debe buscar en /srv-status
	handle_errors {
		root * /srv
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}
